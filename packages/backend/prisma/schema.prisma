generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
}

enum Temperature {
  HOT
  WARM
  COLD
  UNDEFINED
}

enum MessengerType {
  WHATSAPP
  TELEGRAM
  VIBER
  INSTAGRAM_DM
  OTHER
}

enum VehicleInterestType {
  SPECIFIC_CAR
  SPECIFIC_MODEL
  SEVERAL_MODELS
  UNDECIDED
}

enum ContactType {
  CALL
  MESSAGE
  MEETING
  OTHER
}

enum TaskStatus {
  PENDING
  DONE
  CANCELLED
}

enum InteractionType {
  CALL
  MESSAGE
  MEETING
  COMMENT
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  REASSIGN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leadsOwned    Lead[]         @relation("LeadManager")
  tasksAssigned Task[]         @relation("TaskAssignee")
  interactions  Interaction[]
  refreshTokens RefreshToken[]
  auditEntries  AuditLog[]

  @@index([role, isActive])
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  tokenHash         String    @unique
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  userAgent         String?
  ip                String?

  @@index([userId])
}

// Reference table: statuses are admin-editable (name/order/color), but business
// logic must only ever branch on isWon/isLost — never on `key` or `name` strings,
// so relabeling a status never breaks behavior.
model LeadStatus {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  order     Int
  color     String?
  isWon     Boolean  @default(false)
  isLost    Boolean  @default(false)
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  leads     Lead[]

  @@index([isActive, order])
}

model LeadSource {
  id       String  @id @default(uuid())
  name     String
  order    Int     @default(0)
  isActive Boolean @default(true)
  leads    Lead[]

  @@index([isActive, order])
}

model LossReason {
  id       String  @id @default(uuid())
  name     String
  order    Int     @default(0)
  isActive Boolean @default(true)
  leads    Lead[]

  @@index([isActive, order])
}

model Tariff {
  id          String  @id @default(uuid())
  name        String
  description String?
  price       Decimal @db.Decimal(12, 2)
  isActive    Boolean @default(true)

  interestedLeads Lead[] @relation("InterestedTariff")
  purchasedLeads  Lead[] @relation("PurchasedTariff")

  @@index([isActive])
}

model Lead {
  id                    String          @id @default(uuid())
  firstName             String
  lastName              String
  phone                 String
  messengerType         MessengerType?
  messengerContact      String?
  additionalContactInfo String?
  firstContactDate      DateTime

  sourceId    String
  source      LeadSource  @relation(fields: [sourceId], references: [id])
  managerId   String?
  manager     User?       @relation("LeadManager", fields: [managerId], references: [id])
  statusId    String
  status      LeadStatus  @relation(fields: [statusId], references: [id])
  temperature Temperature @default(UNDEFINED)

  // Client need / manager notes — deliberately free-text rather than over-normalized.
  contactReason String?
  managerNotes  String?

  interestedTariffId String?
  interestedTariff   Tariff? @relation("InterestedTariff", fields: [interestedTariffId], references: [id])
  purchasedTariffId  String?
  purchasedTariff    Tariff? @relation("PurchasedTariff", fields: [purchasedTariffId], references: [id])

  plannedPurchasePeriodText String?
  plannedPurchaseDate       DateTime?
  plannedPurchaseComment    String?

  purchasedCarMake  String?
  purchasedCarModel String?
  purchasedCarYear  Int?
  purchasePrice     Decimal?  @db.Decimal(12, 2)
  purchaseDate      DateTime?

  lossReasonId String?
  lossReason   LossReason? @relation(fields: [lossReasonId], references: [id])
  lossComment  String?

  // Optimistic-concurrency guard: every PATCH must supply the version it read.
  version   Int       @default(1)
  // Soft delete only — client history must never disappear.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicleInterest VehicleInterest?
  tasks           Task[]
  interactions    Interaction[]

  @@index([managerId, deletedAt])
  @@index([statusId])
  @@index([sourceId])
  @@index([temperature])
  @@index([plannedPurchaseDate])
  @@index([phone])
  @@index([lastName, firstName])
}

model VehicleInterest {
  id           String              @id @default(uuid())
  leadId       String              @unique
  lead         Lead                @relation(fields: [leadId], references: [id])
  interestType VehicleInterestType
  make         String?
  model        String?
  year         Int?
  budget       Decimal?            @db.Decimal(12, 2)
  comment      String?
}

model Task {
  id               String      @id @default(uuid())
  leadId           String
  lead             Lead        @relation(fields: [leadId], references: [id])
  assignedToUserId String
  assignedTo       User        @relation("TaskAssignee", fields: [assignedToUserId], references: [id])
  dueAt            DateTime
  contactType      ContactType
  comment          String?
  status           TaskStatus  @default(PENDING)

  // Auto-generated "1 day before planned purchase" reminders: sourcePlannedPurchaseDate
  // makes generation idempotent per-date, so editing the planned date invalidates the old one.
  isAutoGenerated           Boolean   @default(false)
  sourcePlannedPurchaseDate DateTime?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToUserId, dueAt, status])
  @@index([leadId])
}

// Append-only: manager-authored log of calls/messages/meetings/comments. No update
// endpoint, no version column — history must never be edited after the fact.
model Interaction {
  id           String           @id @default(uuid())
  leadId       String
  lead         Lead             @relation(fields: [leadId], references: [id])
  authorUserId String
  author       User             @relation(fields: [authorUserId], references: [id])
  type         InteractionType
  comment      String
  occurredAt   DateTime
  createdAt    DateTime         @default(now())

  @@index([leadId, occurredAt])
}

// Generic, auto-captured old/new field diff for every relevant mutation. Merged
// with Interaction in the lead timeline view. changedByUserId is nullable only for
// system-generated changes (e.g. the reminder cron), never for user actions.
model AuditLog {
  id              String      @id @default(uuid())
  entityType      String
  entityId        String
  leadId          String?
  action          AuditAction
  changes         Json
  changedByUserId String?
  changedBy       User?       @relation(fields: [changedByUserId], references: [id])
  createdAt       DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([leadId])
  @@index([createdAt])
}
